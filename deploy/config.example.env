# === ExTerminus deploy config (example) ===
# Copy this to deploy/config.local.env and edit as needed.

# --- Identity / paths (auto-detects if blank) ---
# APP_USER=""					# defaults to current user
# APP_HOME=""					# defaults to user's home from passwd/ENV
# APP_ROOT=""					# defaults to repo root
# CONFIG_PATH=""				# defautls to $APP_ROOT/deploy

# --- Service ---
# If unset, service name defaults to the repo directory name.
# SERVICE_NAME=""
SERVICE_PORT=5000

# Flask app factory import path (module:callable or module:variable)
APP_FACTORY="exterminus.app:create_app()"

# --- Database (SQLite by default) ---
# DB_PATH and DB_BACKUP_DIR default under $APP_ROOT
# DB_PATH=""
# DB_BACKUP_DIR=""

# --- ngrok (optional) ---
# Leave DOMAIN empty to disable ngrok service by default.
# Set your reserved hostname to enable (e.g., myapp.ngrok.app).
DOMAIN=""
# NGROK_BIN="/usr/local/bin/ngrok"
# TUNNEL_NAME=""				# defaults to $SERVICE_NAME
# REGION=us

# --- Python ---
# VENV_DIR=""					# defaults to $APP_ROOT/.venv

# --- Migrations (0/1) ---
USE_ALEMBIC=0
