# deploy/config.env - portable defaults; override via env or config.local.env

# Who runs the service (default=current shell user)
APP_USER=${APP_USER:-$(id -un)}

# Where the repository lives:
# Prefer the git repo you're running from; fall back to $HOME/exterminus.
APP_ROOT=${APP_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$HOME/exterminus")}

# Derived
APP_HOME=${APP_HOME:-$(getent passwd "$APP_USER" | cut -d: -f6 2>/dev/null || echo "$HOME")}
VENV_DIR=${VENV_DIR:-$APP_ROOT/.venv}

# App / service
SERVICE_NAME=${SERVICE_NAME:-exterminus}
SERVICE_PORT=${SERVICE_PORT:-8000}
APP_FACTORY=${APP_FACTORY:-exterminus.app:create_app()}

# ngrok
NGROK_BIN=${NGROK_BIN:-/usr/local/bin/ngrok}
DOMAIN=${DOMAIN:-exterminus.domain.name}
CONFIG_PATH=${CONFIG_PATH:-$APP_HOME/.config/ngrok/ngrok.yml}
TUNNEL_NAME=${TUNNEL_NAME:-exterminus}
REGION=${REGION:-us}

# DB
DB_PATH=${DB_PATH:-$APP_ROOT/instance/exterminus.sqlite3}
DB_BACKUP_DIR=${DB_BACKUP_DIR:-$APP_ROOT/backups}
USE_ALEMBIC=${USE_ALEMBIC:-0}
